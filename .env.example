# ==============================================================================
# The Skill Tree - Environment Configuration Template
# Copy this file to '.env' and populate your local keys/settings.
# ==============================================================================

# LLM Bridge Engine Settings
# Set your OpenAI API key (or compatible endpoint such as Groq, Ollama, OpenRouter)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=250

# Graph Engine & Pathfinding Settings
FUZZY_MATCH_THRESHOLD=82.0
DEFAULT_EXPANSION_COUNT=3
MAX_PATH_HOPS=10

# Optional Server Settings
DEBUG=false
